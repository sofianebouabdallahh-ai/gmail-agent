# LLM backend: api = LangChain + ANTHROPIC_API_KEY (pay-as-you-go credits)
#              claude_code = Claude Agent SDK + your Claude Code login (e.g. Max plan)
LLM_BACKEND=api

# Anthropic (only needed when LLM_BACKEND=api)
ANTHROPIC_API_KEY=sk-ant-...
# Models (defaults shown)
TRIAGE_MODEL=claude-opus-5-5
TRIAGE_EFFORT=high
EXTRACT_MODEL=claude-sonnet-5-5
EXTRACT_EFFORT=medium
# Server-side refusal fallbacks (1 = on, 0 = off)
ANTHROPIC_FALLBACKS=1

# Gmail OAuth files (downloaded from Google Cloud console)
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# Local state
STATE_DB=state.db

# Optional: LangSmith tracing
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=gmail-agent
