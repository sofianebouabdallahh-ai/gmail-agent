# LLM backend: api = LangChain + ANTHROPIC_API_KEY (pay-as-you-go credits)
#              claude_code = Claude Agent SDK + your Claude Code login (e.g. Max plan)
LLM_BACKEND=api

# Anthropic (only needed when LLM_BACKEND=api)
ANTHROPIC_API_KEY=sk-ant-...
# Models (defaults shown)
TRIAGE_MODEL=claude-opus-5-5
TRIAGE_EFFORT=high
EXTRACT_MODEL=claude-sonnet-5-5
EXTRACT_EFFORT=medium
# Server-side refusal fallbacks (1 = on, 0 = off)
ANTHROPIC_FALLBACKS=1

# Gmail OAuth files (downloaded from Google Cloud console)
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# Guardrails (enforced in code after the triage agent decides)
DRY_RUN=false
MIN_CONFIDENCE=0.6
ALLOWED_LABELS=Finance,Receipts,Travel,Insurance,Health,Work,Shopping,Newsletters,Calendar,Personal

# Local state and owner profile (copy src/gmail_agent/harness/owner.example.md to owner.md)
STATE_DB=state.db
OWNER_FILE=owner.md

# Optional: LangSmith tracing
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=gmail-agent
